# Copy to .env and fill in. .env is gitignored; this template is not.
#
# SkillSpector has no python-dotenv dependency and will NOT read this file
# automatically. Export it into your shell before scanning:
#
#     set -a; source .env; set +a
#     skillspector scan plugins/dev-workflow
#
# CI does not use this file at all - it reads the SKILLSPECTOR_COMPAT_API_KEY
# Actions secret. See docs/SECURITY.md.

# Example: Gemini via its OpenAI-compatible endpoint. Any SkillSpector
# provider works - see docs/skill-policy.md for the full matrix.
SKILLSPECTOR_PROVIDER=openai_compatible
SKILLSPECTOR_COMPAT_API_KEY=
SKILLSPECTOR_COMPAT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
SKILLSPECTOR_MODEL=gemini-3.7-flash
