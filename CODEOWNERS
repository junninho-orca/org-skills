# Every change here is a supply-chain change for every engineer who has the
# marketplace installed. Review is not optional.
#
# NOTE: this repo currently lives under a personal account, which has no teams.
# All rules therefore point at the owner. On moving to an org, replace these
# with real teams so that security-owned paths need a second, different pair of
# eyes - a single owner approving their own security policy is not a control.

# Default owner for everything.
*                                @junninho-orca

# Gate definition and policy. These decide what is allowed to merge at all.
/docs/skill-policy.md            @junninho-orca
/.github/workflows/              @junninho-orca
/CODEOWNERS                      @junninho-orca

# A suppression is a policy decision, not a build fix.
/.skillspector-baseline.yaml     @junninho-orca

# Weakening the known-bad fixture disarms the gate self-test.
/tests/fixtures/                 @junninho-orca

# Marketplace membership is the trust boundary: adding an entry here is what
# actually ships a plugin to everyone.
/.claude-plugin/marketplace.json @junninho-orca

# Per-plugin owners.
/plugins/dev-workflow/           @junninho-orca
/plugins/incident-response/      @junninho-orca
